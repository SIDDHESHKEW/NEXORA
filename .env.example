# Environment Configuration
APP_ENV=development
DATABASE_URL=sqlite:///./nexora.db
JWT_SECRET=sgsu-ai-university-platform-secret-key-32chars
JWT_TTL_HOURS=8
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# AI Gateway Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_S=25
AI_FORCE_FALLBACK=false

# Multi-Provider API Keys (Optional - Deterministic fallbacks activate automatically if omitted)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GROK_API_KEY=

# Classroom Settings
ALLOW_AUDIENCE_JOIN=true
FRONTEND_JOIN_URL=http://localhost:5173/join

# Pedagogical & Evidence Constants
MASTERY_STRONG=70
MASTERY_DEVELOPING=50
GAP_MIN_SHARE=0.40
GAP_MIN_RESPONDENTS=10
PRIOR_WEIGHT=2.0
W_EXIT_QUIZ=0.8
W_LIVE_POLL=0.5
W_PRACTICE=0.4
MIN_GROUP_SIZE=5

# Rate Limits
RATE_LIMIT_AI_PER_MIN=10
RATE_LIMIT_GENERAL_PER_MIN=120
